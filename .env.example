# Public HTTPS origin served by the reverse proxy. Do not add a trailing slash.
APP_ORIGIN=https://nana.example.com

# Generate a long random value for each deployment; never commit the real value.
REDIS_PASSWORD=replace-with-a-long-random-password

# Keep 0 unless requests cross a proxy you administer and configure to replace,
# not append to, the client-IP forwarding header.
TRUSTED_PROXY_HOPS=0

# Guest session lifetime in seconds (the application caps this at seven days).
SESSION_TTL_SECONDS=3600
